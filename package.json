{
  "name": "gitstudio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "tauri": "tauri",
    "bridge": "cargo run -p gitstudio --bin gitstudio-bridge --features dev-bridge",
    "format:check": "prettier --check .",
    "release": "node scripts/release.mjs",
    "check:version": "node scripts/release.mjs --check"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
